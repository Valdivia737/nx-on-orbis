From c193ccc8776e07e7bba58b8b00e833d7859fe24e Mon Sep 17 00:00:00 2001
From: Valdivia737 <104042867+Valdivia737@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:16:58 -0300
Subject: [PATCH] ORBIS fastmem: map view pages whose 4 KiB pieces are only
 partly mapped

A 16 KiB view page was mapped only when all four 4 KiB guest pages in it
were mapped. Thread stacks start and end at 4 KiB boundaries, so the hot
top of most stacks sat in a partly mapped page and every stack access there
faulted and was moved to the page-table path (~89,000 redirects in 3D World).
Map such pages anyway, with the access of the pieces that are mapped, and
drop the host page again when a piece that was reachable is unmapped.
Redirects are now classified by the 4 KiB piece that faulted.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/orbis_lazy_memory.cpp | 35 +++++++++++++++++++++++---------
 1 file changed, 25 insertions(+), 10 deletions(-)

diff --git a/src/common/orbis_lazy_memory.cpp b/src/common/orbis_lazy_memory.cpp
index 3d6f214..d817372 100644
--- a/src/common/orbis_lazy_memory.cpp
+++ b/src/common/orbis_lazy_memory.cpp
@@ -130,13 +130,15 @@ bool CommitAddress(std::uintptr_t addr) {
 //   bits 32..35  4 KiB guest page mapped here (by ViewMap, cleared by ViewUnmap)
 //   bits 36..39  ... readable
 //   bits 40..43  ... writable
+//   bits 44..47  guest pages that were mapped when the host page was mapped
 //   bits 48..49  what the host has: 0 nothing (reserved), 1 mapped read-only, 2 read-write
 // All of it under g_lock, like the chunk tables.
 constexpr std::size_t ViewPage = 16 * 1024;
 constexpr std::size_t SubPage = 4 * 1024;
 constexpr std::size_t ViewSpanBits = 30;
 constexpr std::size_t PagesPerSpan = (std::size_t{1} << ViewSpanBits) / ViewPage;
-constexpr std::uint64_t ValidShift = 32, ReadShift = 36, WriteShift = 40, HostShift = 48;
+constexpr std::uint64_t ValidShift = 32, ReadShift = 36, WriteShift = 40, MappedShift = 44,
+                        HostShift = 48;
 constexpr int ProtRead = 0x01, ProtReadWrite = 0x03;
 
 std::atomic<bool> g_fastmem_ok{false};
@@ -175,10 +177,14 @@ int WantedHost(std::uint64_t e) {
     const unsigned valid = (e >> ValidShift) & 0xF;
     const unsigned read = (e >> ReadShift) & 0xF;
     const unsigned write = (e >> WriteShift) & 0xF;
-    if (valid != 0xF || read != 0xF) {
+    // 4 KiB pieces the guest has not mapped (the guard pages around a thread stack, the ends of a
+    // mapping that is not 16 KiB-aligned) do not keep the page out of the view; only the mapped
+    // ones decide its access. A guest access to an unmapped piece then reaches the backing instead
+    // of faulting, which only a stack overflow or a use-after-unmap would do.
+    if (valid == 0 || (read & valid) != valid) {
         return 0;
     }
-    return write == 0xF ? 2 : 1;
+    return (write & valid) == valid ? 2 : 1;
 }
 
 void ReserveViewPage(std::uintptr_t addr) {
@@ -193,7 +199,7 @@ void ReserveViewPage(std::uintptr_t addr) {
 void DropHostLocked(std::size_t page, std::uint64_t& e) {
     if (((e >> HostShift) & 3) != 0) {
         ReserveViewPage(g_view_base + page * ViewPage);
-        e &= ~(std::uint64_t{3} << HostShift);
+        e &= ~((std::uint64_t{3} << HostShift) | (std::uint64_t{0xF} << MappedShift));
         g_view_mapped.fetch_sub(1, std::memory_order_relaxed);
     }
 }
@@ -202,14 +208,21 @@ void DropHostLocked(std::size_t page, std::uint64_t& e) {
 /// first touch; this only takes access away (or changes it on a page already mapped).
 void ApplyLocked(std::size_t page, std::uint64_t& e) {
     const int have = static_cast<int>((e >> HostShift) & 3);
-    const int want = WantedHost(e);
-    if (have == want || have == 0) {
+    if (have == 0) {
         return;
     }
-    if (want == 0) {
+    const std::uint64_t valid = (e >> ValidShift) & 0xF;
+    const std::uint64_t mapped = (e >> MappedShift) & 0xF;
+    const int want = WantedHost(e);
+    if (want == 0 || (valid & mapped) != mapped) {
+        // Unmapped by the guest (or a piece that was reachable is gone): it must fault again.
         DropHostLocked(page, e);
         return;
     }
+    e = (e & ~(std::uint64_t{0xF} << MappedShift)) | (valid << MappedShift);
+    if (have == want) {
+        return;
+    }
     const std::uintptr_t addr = g_view_base + page * ViewPage;
     if (sceKernelMprotect(reinterpret_cast<void*>(addr), ViewPage,
                           want == 2 ? ProtReadWrite : ProtRead) != 0) {
@@ -256,7 +269,8 @@ bool ViewFault(std::uintptr_t addr) {
         reinterpret_cast<std::uintptr_t>(at) != g_view_base + page * ViewPage) {
         return false;
     }
-    *e = (*e & ~(std::uint64_t{3} << HostShift)) | (std::uint64_t(want) << HostShift);
+    *e = (*e & ~((std::uint64_t{3} << HostShift) | (std::uint64_t{0xF} << MappedShift))) |
+         (std::uint64_t(want) << HostShift) | (((*e >> ValidShift) & 0xF) << MappedShift);
     g_view_mapped.fetch_add(1, std::memory_order_relaxed);
     g_view_touches.fetch_add(1, std::memory_order_relaxed);
     return true;
@@ -313,9 +327,10 @@ void FaultHandler(int signal, void* ucontext) {
             sample = addr - g_view_base;
             SpinGuard guard;
             const std::uint64_t* e = ViewEntryLocked((addr - g_view_base) / ViewPage, false);
-            if (e == nullptr || ((*e >> ValidShift) & 0xF) != 0xF) {
+            const unsigned valid = e != nullptr ? (*e >> ValidShift) & 0xF : 0;
+            if (((valid >> (((addr - g_view_base) % ViewPage) / SubPage)) & 1) == 0) {
                 reason = 1;
-            } else if (((*e >> ReadShift) & 0xF) != 0xF) {
+            } else if ((((*e >> ReadShift) & 0xF) & valid) != valid) {
                 reason = 2;
             } else if (((*e >> HostShift) & 3) == 1) {
                 reason = 3;
-- 
