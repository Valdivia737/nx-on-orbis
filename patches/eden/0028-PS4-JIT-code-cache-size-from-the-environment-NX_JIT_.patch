+#endif
 
 namespace Core {
 
@@ -265,7 +269,9 @@ void ArmDynarmic64::MakeJit(Common::PageTable* page_table, std::size_t address_s
 #if defined(__ORBIS__)
     // PS4: the code cache is direct memory taken up front (32 MiB since test 5: memory ran out), from ~3.4 GiB shared with the guest
     // RAM; four cores at 512 MiB would take most of it. A smaller cache flushes more often.
-    config.code_cache_size = std::uint32_t(32_MiB);
+    // 32 MiB unless settings.txt sets NX_JIT_CACHE_MIB / NX_JIT_CACHE_MIB_CORE3 (common/orbis_jit.h).
+    config.code_cache_size = std::uint32_t(Common::Orbis::JitCacheMiB(m_core_index) * 1_MiB);
+    LOG_INFO(Core_ARM, "PS4: core {} A64 JIT code cache {} MiB", m_core_index, config.code_cache_size >> 20);
 #elif defined(ARCHITECTURE_arm64) || defined(__sun__) || defined(__NetBSD__) || defined(__DragonFly__) || defined(__OpenBSD__)
     config.code_cache_size = std::uint32_t(128_MiB);
 #else
diff --git a/src/dynarmic/src/dynarmic/backend/x64/a32_interface.cpp b/src/dynarmic/src/dynarmic/backend/x64/a32_interface.cpp
index 72627b9..5e7dba0 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/a32_interface.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/a32_interface.cpp
@@ -30,6 +30,9 @@
 #include "dynarmic/ir/basic_block.h"
 #include "dynarmic/ir/location_descriptor.h"
 #include "dynarmic/ir/opt_passes.h"
+#if defined(__ORBIS__)
+#include "common/orbis_jit.h"
+#endif
 
 namespace Dynarmic::A32 {
 
@@ -194,6 +197,9 @@ private:
 
         constexpr size_t MINIMUM_REMAINING_CODESIZE = 1 * 1024 * 1024;
         if (block_of_code.SpaceRemaining() < MINIMUM_REMAINING_CODESIZE) {
+#if defined(__ORBIS__)
+            ::Common::Orbis::CountJitCacheFlush(conf.processor_id);
+#endif
             invalidate_entire_cache = true;
             PerformRequestedCacheInvalidation(HaltReason::CacheInvalidation);
         }
diff --git a/src/dynarmic/src/dynarmic/backend/x64/a64_interface.cpp b/src/dynarmic/src/dynarmic/backend/x64/a64_interface.cpp
index bb07212..c3b88a8 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/a64_interface.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/a64_interface.cpp
@@ -26,6 +26,9 @@
 #include "dynarmic/interface/A64/a64.h"
 #include "dynarmic/ir/basic_block.h"
 #include "dynarmic/ir/opt_passes.h"
+#if defined(__ORBIS__)
+#include "common/orbis_jit.h"
+#endif
 
 namespace Dynarmic::A64 {
 
@@ -248,6 +251,9 @@ private:
         constexpr size_t MINIMUM_REMAINING_CODESIZE = 1 * 1024 * 1024;
         if (block_of_code.SpaceRemaining() < MINIMUM_REMAINING_CODESIZE) {
             // Immediately evacuate cache
+#if defined(__ORBIS__)
+            ::Common::Orbis::CountJitCacheFlush(conf.processor_id);
+#endif
             invalidate_entire_cache = true;
             PerformRequestedCacheInvalidation(HaltReason::CacheInvalidation);
         }
