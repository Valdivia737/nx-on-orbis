@@ -6,6 +6,7 @@
 
 #pragma once
 
+#include <functional>
 #include <memory>
 #include <span>
 #include <vector>
@@ -84,10 +85,27 @@ namespace Vulkan {
         void *mapped_ptr{};  ///< Optional persistent mapped pointer
     };
 
+#ifdef __ORBIS__
+    /// PS4 (adapted from Eden4, github.com/xatyy/Eden4, GPL-3.0): the renderer registers a way to
+    /// give GPU memory back (wait for the GPU, drop idle staging buffers); allocations run it, on
+    /// the renderer's thread only, when VMA's budget gets low or an allocation fails, then retry.
+    void SetPs4MemoryReclaim(std::function<void()> reclaim);
+    void ClaimPs4ReclaimThread();
+    /// Runs the reclaim if this is the renderer's thread and (force or) the device-local budget has
+    /// less than `need` plus a headroom left. Returns whether it ran.
+    bool Ps4Reclaim(VmaAllocator allocator, size_t need, bool force);
+#endif
+
 /// Memory allocator container.
 /// Allocates and releases memory allocations on demand.
     class MemoryAllocator {
     public:
+#ifdef __ORBIS__
+        /// For Ps4Reclaim's budget check from outside the allocator (the staging buffer pool).
+        VmaAllocator Ps4Allocator() const noexcept {
+            return allocator;
+        }
+#endif
         /**
          * Construct memory allocator
          *
