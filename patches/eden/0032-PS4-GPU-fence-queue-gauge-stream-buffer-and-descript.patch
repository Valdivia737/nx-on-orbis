                 current_operations = std::move(pending_operations.front());
                 fences.pop();
                 pending_operations.pop_front();
+#ifdef __ORBIS__
+                ::Common::Orbis::NoteGpuFences(fences.size());
+#endif
             }
             if (!current_fence->IsStubbed()) {
                 WaitFence(current_fence);
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index df39f4c..e617ee6 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -15,6 +15,9 @@
 
 #include "common/assert.h"
 #include "common/logging.h"
+#ifdef __ORBIS__
+#include "common/orbis_jit.h"
+#endif
 #include "common/scope_exit.h"
 #include "common/settings.h"
 #include "video_core/buffer_cache/buffer_cache.h"
@@ -203,9 +206,21 @@ RasterizerVulkan::RasterizerVulkan(Core::Frontend::EmuWindow& emu_window_, Tegra
     : gpu{gpu_}, device_memory{device_memory_}, device{device_},
       memory_allocator{memory_allocator_}, state_tracker{state_tracker_}, scheduler{scheduler_},
       staging_pool(device, memory_allocator, scheduler), descriptor_pool(device, scheduler),
+#ifdef __ORBIS__
+      // PS4: these payloads are 96 + 24 MiB of C heap (8 frames in flight); settings.txt
+      // env=NX_DESC_PAYLOAD=<entries per frame> shrinks both (compute keeps its 1/4 share).
+      guest_descriptor_queue(device,
+                             ::Common::Orbis::EnvSize("NX_DESC_PAYLOAD", UpdateDescriptorQueue::GUEST_FRAME_PAYLOAD_SIZE,
+                                                      0x8000, UpdateDescriptorQueue::GUEST_FRAME_PAYLOAD_SIZE),
+                             device.IsExtDescriptorBufferSupported()),
+      compute_pass_descriptor_queue(device,
+                                    ::Common::Orbis::EnvSize("NX_DESC_PAYLOAD", UpdateDescriptorQueue::GUEST_FRAME_PAYLOAD_SIZE,
+                                                             0x8000, UpdateDescriptorQueue::GUEST_FRAME_PAYLOAD_SIZE) / 4),
+#else
       guest_descriptor_queue(device, UpdateDescriptorQueue::GUEST_FRAME_PAYLOAD_SIZE,
                              device.IsExtDescriptorBufferSupported()),
       compute_pass_descriptor_queue(device, UpdateDescriptorQueue::COMPUTE_FRAME_PAYLOAD_SIZE),
+#endif
       descriptor_buffer_ring(device, memory_allocator),
       blit_image(device, scheduler, state_tracker, descriptor_pool), render_pass_cache(device),
       texture_cache_runtime{
diff --git a/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp b/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
index 7b6571d..4270449 100644
--- a/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
+++ b/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
@@ -19,6 +19,9 @@
 #include "video_core/renderer_vulkan/vk_staging_buffer_pool.h"
 #include "video_core/vulkan_common/vulkan_device.h"
 #include "video_core/vulkan_common/vulkan_wrapper.h"
+#ifdef __ORBIS__
+#include "common/orbis_jit.h"
+#endif
 
 namespace Vulkan {
 namespace {
@@ -40,6 +43,14 @@ constexpr VkDeviceSize MAX_STREAM_BUFFER_SIZE = 256_MiB;
 #endif
 
 size_t GetStreamBufferSize(const Device& device) {
+#ifdef __ORBIS__
+    // PS4: the stream buffer lives in the driver's arena next to every image; the FreeBSD build's
+    // 128 MiB was not picked up because the PS4 build undefines __FreeBSD__. settings.txt
+    // env=NX_STREAM_BUFFER_MIB (32..256), 256 by default as before.
+    if (!device.HasDebuggingToolAttached()) {
+        return ::Common::Orbis::EnvSize("NX_STREAM_BUFFER_MIB", 256, 32, 256) * 1_MiB;
+    }
+#endif
     if (!device.HasDebuggingToolAttached()) {
         return MAX_STREAM_BUFFER_SIZE;
     }
